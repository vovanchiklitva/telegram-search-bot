# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# PostgreSQL connection string (used by Prisma)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/shopbot?schema=public

# Redis connection (Telegraf sessions, BullMQ queues, caches)
REDIS_URL=redis://redis:6379

# OpenAI API key (GPT-4o-mini, Vision, embeddings)
OPENAI_API_KEY=sk-...

# Wildberries official API key (Statistics / Supplier or Partner API)
WB_API_KEY=
# Ozon Client Id / Client Secret (official API)
OZON_API_KEY=
OZON_CLIENT_ID=
# AliExpress official affiliate API (AliExpress Open Platform)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
# Affiliate tracking IDs appended to outbound links as UTM params
PARTNER_WB_UTM=
PARTNER_OZON_UTM=
PARTNER_ALIEXPRESS_UTM=

# Comma-separated list of Telegram chat ids that are admins
ADMIN_IDS=123456789,987654321

# Comma-separated list of proxy URLs for Puppeteer parsing.
# Supports http(s)://user:pass@host:port and socks5://host:port
PROXY_LIST=http://user:pass@proxy1.example.com:8080,http://user:pass@proxy2.example.com:8080

# Optional: admin chat for error notifications (separate from ADMIN_IDS)
ERROR_NOTIFY_CHAT_ID=

# Cache TTLs (seconds)
CACHE_RESULTS_TTL=900
CACHE_LLM_PARAMS_TTL=3600

# Rate limiting: max searches per user per minute
RATE_LIMIT_SEARCH_PER_MIN=10

# Queue overload threshold
QUEUE_MAX_PENDING=50

# Search timeouts (ms)
TIMEOUT_API_MS=8000
TIMEOUT_PARSER_MS=15000

# Price-alert job interval (cron or ms). Default every 6 hours.
PRICE_ALERT_CRON=0 */6 * * *
