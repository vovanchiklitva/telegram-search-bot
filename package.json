{
  "name": "shop-search-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/bot/index.js",
  "scripts": {
    "postinstall": "rm -rf /opt/render/.cache/puppeteer && npx puppeteer browsers install chrome",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/start.js",
    "start:bot": "node dist/bot/index.js",
    "start:worker": "node dist/worker/index.js",
    "dev:bot": "tsx src/bot/index.ts",
    "dev:worker": "tsx src/worker/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "express": "^4.18.2",
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.7",
    "bullmq": "^5.21.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "openai": "^4.67.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "puppeteer": "^23.6.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
